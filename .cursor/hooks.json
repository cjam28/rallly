{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/session-end.sh",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/log-meta-edit.sh"
      }
    ]
  }
}
